# Example environment variables for TrueFeed Frontend
# Copy this file to `.env.local` and fill with real values before running.

NEXT_PUBLIC_API_URL=https://172.18.0.1:4000
API_ENDPOINT=/api/v1/
AUTH=auth
LOGIN_ENDPOINT=/login
REGISTER_ENDPOINT=/register
USER_PROFILE_ENDPOINT=/me
POSTS_ENDPOINT=/posts
COMMENTS_ENDPOINT=/comments
MEDIA_UPLOAD_ENDPOINT=/media/upload