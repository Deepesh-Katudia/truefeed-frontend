# Frontend env vars (copy to .env.local and adjust as needed)
# API endpoints (defaults align with backend router paths)
NEXT_PUBLIC_API_PROFILE=/api/v1/profile
NEXT_PUBLIC_API_PROFILE_UPDATE=/api/v1/profile/update
NEXT_PUBLIC_API_PROFILE_UPLOAD_PICTURE=/api/v1/profile/upload-picture
NEXT_PUBLIC_API_PROFILE_UPDATE_WITH_PICTURE=/api/v1/profile/update-with-picture

NEXT_PUBLIC_API_POSTS=/api/v1/posts
NEXT_PUBLIC_API_POSTS_MINE=/api/v1/posts/mine
NEXT_PUBLIC_API_POSTS_UPLOAD_MEDIA=/api/v1/posts/upload-media
NEXT_PUBLIC_API_POSTS_CREATE_WITH_MEDIA=/api/v1/posts/create-with-media

NEXT_PUBLIC_API_AUTH_LOGIN=/api/v1/auth/login
NEXT_PUBLIC_API_AUTH_REGISTER=/api/v1/auth/register
NEXT_PUBLIC_API_AUTH_LOGOUT=/api/v1/auth/logout

NEXT_PUBLIC_API_LOGS=/api/v1/logs
NEXT_PUBLIC_API_FILES=/api/v1/files

# Routes used by the app router
NEXT_PUBLIC_ROUTE_PROFILE=/profile
NEXT_PUBLIC_ROUTE_LOGIN=/login
NEXT_PUBLIC_ROUTE_REGISTER=/register
